# Copie este ficheiro para .env e preencha os valores.
# NUNCA envie .env para o Git.

# Ambiente: development | production
APP_ENV=development

# Hora diária de execução do coletor (Europe/Lisbon)
SCHEDULE_DAILY_TIME=07:30

# Segredo opcional usado pelo painel Streamlit para limitar acesso.
# Deixe vazio para desativar. Quando definido, o painel pede a palavra-passe.
STREAMLIT_PASSWORD=

# Notificações (reservado para versões futuras)
NOTIFICATIONS_ENABLED=false
